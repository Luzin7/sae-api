DATABASE_URL=postgres://user:password@localhost:5432/sae
JWT_SECRET=your-super-secret-key-here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
# Proxies in front of the API whose X-Forwarded-For is trusted (request.ip).
# Unset/false: trust none. Integer N: trust the last N hops (the API must only be reachable through them). CIDR list also accepted. Avoid "true" (client can spoof its IP).
# Render behind the Vercel rewrite (/api/* -> API): 2 (Render proxy + Vercel edge)
TRUST_PROXY=
